#include<iostream>
using namespace std;

class Nodo {
public:
    int dato;
    Nodo* siguiente;

    Nodo(int valor);
};

class Pila {
private:
    Nodo* cima;

public:
    Pila();
    bool Push(int dato);
    bool Pop();
    void VerCima();
    void VerPila();
    void Tamanio();
    bool Vacia();
};

int main() {
    Pila p;
    int opcion, dato;

    do {
        cout << endl;
        cout << "===== MENU PILA DINAMICA =====" << endl;
        cout << "1. Push (Insertar)" << endl;
        cout << "2. Pop (Eliminar)" << endl;
        cout << "3. Ver cima" << endl;
        cout << "4. Ver pila" << endl;
        cout << "5. Tamanio" << endl;
        cout << "0. Salir" << endl;
        cout << "Seleccione una opcion: ";
        cin >> opcion;

        switch (opcion) {
        case 1:
            cout << "Ingrese dato: ";
            cin >> dato;
            p.Push(dato);
            break;

        case 2:
            if (p.Pop())
                cout << "Elemento eliminado" << endl;
            break;

        case 3:
            p.VerCima();
            break;

        case 4:
            p.VerPila();
            break;

        case 5:
            p.Tamanio();
            break;

        case 0:
            cout << "Saliendo..." << endl;
            break;

        default:
            cout << "Opcion invalida" << endl;
        }

    } while (opcion != 0);

    return 0;
}

Nodo::Nodo(int valor) {
    dato = valor;
    siguiente = NULL;
}

Pila::Pila() {
    cima = NULL;
}

bool Pila::Push(int dato) {
    Nodo* nuevo = new Nodo(dato);

    nuevo->siguiente = cima;
    cima = nuevo;

    return true;
}

bool Pila::Pop() {
    if (Vacia()) {
        cout << "Pila vacia" << endl;
        return false;
    }

    Nodo* aux = cima;
    cima = cima->siguiente;
    delete aux;

    return true;
}

void Pila::VerCima() {
    if (Vacia()) {
        cout << "Pila vacia" << endl;
    } else {
        cout << "Cima: " << cima->dato << endl;
    }
}

void Pila::VerPila() {
    if (Vacia()) {
        cout << "Pila vacia" << endl;
    } else {
        Nodo* aux = cima;

        while (aux != NULL) {
            cout << aux->dato << " -> ";
            aux = aux->siguiente;
        }

        cout << "NULL" << endl;
    }
}

void Pila::Tamanio() {
    int contador = 0;
    Nodo* aux = cima;

    while (aux != NULL) {
        contador++;
        aux = aux->siguiente;
    }

    cout << "Tamanio: " << contador << endl;
}

bool Pila::Vacia() {
    return cima == NULL;
}
