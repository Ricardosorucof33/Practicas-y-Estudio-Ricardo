#include<iostream>
#define MAX 100
using namespace std;
class Cola {
private:
	int frente;
	int final;
	int datos[MAX];
public:
	Cola();
	bool Insertar(int elemento);
	bool Quitar();
	bool ColaVacia();
	bool ColaLlena();
	void VerInicio();
	void VerCola();

};
int main() {
    Cola c;
    int opcion, x;

    do {
        cout << "\n--- MENU COLA ---\n";
        cout << "1. Insertar\n";
        cout << "2. Quitar\n";
        cout << "3. Ver inicio\n";
        cout << "4. Ver cola\n";
        cout << "5. Cola vacia?\n";
        cout << "6. Cola llena?\n";
        cout << "0. Salir\n";
        cout << "Opcion: ";
        cin >> opcion;

        switch (opcion) {

        case 1:
            cout << "Ingrese valor: ";
            cin >> x;
            if (c.Insertar(x))
                cout << "Insertado\n";
            break;

        case 2:
            if (c.Quitar())
                cout << "Elemento eliminado\n";
            break;

        case 3:
            c.VerInicio();
            cout << endl;
            break;

        case 4:
            c.VerCola();
            break;

        case 5:
            if (c.ColaVacia())
                cout << "Esta vacia\n";
            else
                cout << "No esta vacia\n";
            break;

        case 6:
            if (c.ColaLlena())
                cout << "Esta llena\n";
            else
                cout << "No esta llena\n";
            break;

        case 0:
            cout << "Saliendo...\n";
            break;

        default:
            cout << "Opcion invalida\n";
        }

    } while (opcion != 0);

    return 0;
}
Cola::Cola() {
	frente = -1;
	final= -1;
}
bool Cola::Insertar(int elemento) {
	if (ColaLlena()) {
		cout << "Cola llena\n";
		return false;
	}

	if (ColaVacia()) {
		frente = 0;
		final = 0;
	}
	else {
		final++;
	}

	datos[final] = elemento;
	return true;
}
bool Cola::Quitar() {

	if (ColaVacia()) {
		cout << "Cola vacia"<<endl;
		return false;
	}

	if (frente == final) {
		// Era el último elemento
		frente = -1;
		final = -1;
	}
	else {
		frente++;
	}

	return true;
}

bool Cola::ColaVacia() {
	return frente == -1;
}
bool Cola::ColaLlena() {
	return final == MAX - 1;
}
void Cola::VerInicio() {
	if (ColaVacia())
		cout << "cola vacia" << endl;
	else 
	cout << "el frente es" << datos[frente];
}
void Cola::VerCola() {
	if (ColaVacia())
		cout << "cola vacia" << endl;
	else
	for (int i = frente;i <= final;i++)
		cout << "elemento " << i << " = " << datos[i]<<endl;
}
